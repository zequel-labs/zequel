{
  "compilerOptions": {
    "composite": false,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@e2e/*": ["src/tests/e2e/*"],
      "@main/*": ["src/main/*"],
      "@/*": ["src/renderer/*"]
    }
  },
  "include": [
    "src/tests/e2e/**/*.ts",
    "src/renderer/types/electron.d.ts"
  ]
}
